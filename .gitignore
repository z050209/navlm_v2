# environments
.venv/
venv/
__pycache__/
*.pyc

# secrets — CRITICAL: never commit GCP/AWS/HF credentials
.env
*.key
# contains GCP service-account JSONs (key-1.json etc.)
keys/
*-credentials.json
*service-account*.json

# video files
*.mp4
*.mov
*.webm
*.avi
*.mkv

# image files (training frames + cached crops) — but DO commit paper figures
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.tiff
# exception: paper figures live under docs/figures/ and SHOULD be tracked
!docs/figures/
!docs/figures/**

# checkpoints / model weights
checkpoints/
models/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.gguf
*.npz
*.pkl

# data & large artifacts (host on Hugging Face, not git)
data/
results/
*.pdf

# generated / local
costs/
preview/
*.log
logs/gemini_api.jsonl
.DS_Store

# Attempt-2 ephemeral build artifacts (large, regeneratable)
# cache/: DINO/Vertex AI response caches (~500 MB)
# _trial_snapshot/: local staging dirs for Modal uploads (~600 MB)
# _ablation_logs/: per-run Modal job logs
# eval_pull/: downloaded eval results from Modal
# eval_results/: legacy eval outputs
# data/sft/: SFT split files (regenerated from annotations)
cache/
_trial_snapshot/
_ablation_logs/
eval_pull/
eval_results/
data/sft/
